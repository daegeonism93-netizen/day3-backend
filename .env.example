# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 GitHub에 올리지 않습니다)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=여기에_supabase_키
# 허용할 프론트 주소 (쉼표로 여러 개)
# 로컬: 프론트를 여는 주소 / Railway 배포: Vercel 주소
FRONT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# 공공데이터포털(data.go.kr) 인증키 - 발급 후 입력 (비우면 연습 모드)
DATA_GO_KR_KEY=
# POST /collect 를 아무나 못 누르게 하는 암호 (직접 정한 긴 문자열)
ADMIN_TOKEN=
SIDO_NAME=제주
COLLECT_MINUTES=60
